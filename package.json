{
  "name": "@jelly-kits/jelly-ui-uniapp",
  "version": "0.2.0",
  "description": "Jelly UI 的 uni-app 版：跨端组件库，微信小程序与 H5 同源，支持 easycom 按需引入",
  "license": "MIT",
  "homepage": "https://jelly-kits.github.io/jelly-ui-uniapp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jelly-kits/jelly-ui-uniapp.git"
  },
  "bugs": {
    "url": "https://github.com/jelly-kits/jelly-ui-uniapp/issues"
  },
  "keywords": [
    "uni-app",
    "uniapp",
    "vue3",
    "typescript",
    "组件库",
    "ui",
    "微信小程序",
    "h5",
    "jelly-ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "components",
    "core",
    "theme",
    "README.md"
  ],
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "dev:app-harmony": "uni -p app-harmony",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app",
    "build:app-harmony": "uni build -p app-harmony",
    "build:pkg": "node scripts/build-package.mjs",
    "prepack": "npm run build:pkg",
    "gen:api": "node scripts/gen-api.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-harmony": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "typescript": "^5.6.3",
    "vite": "5.2.8",
    "vue": "^3.4.21",
    "vue-tsc": "^2.1.10"
  }
}
